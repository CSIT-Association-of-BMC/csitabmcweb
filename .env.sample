# ==============================================================================
# CSITABMC Public Web Portal Environment Configuration Sample (.env.sample)
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Variables prefixed with NEXT_PUBLIC_ are inlined into client-side
# JavaScript bundles during `npm run build`. Modifying these variables in production
# requires a full rebuild and redeployment of the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Site Canonical URL
# ------------------------------------------------------------------------------
# The fully-qualified base URL for the public website.
# Used for OpenGraph social sharing tags, canonical link generation, and sitemaps.
NEXT_PUBLIC_SITE_URL=""

# ------------------------------------------------------------------------------
# 2. Django REST Framework Public CMS API
# ------------------------------------------------------------------------------
# Authoritative backend API base URL for querying public events, notices, tenures,
# members, alumni, blogs, certificates, and past papers.
# Format: https://<domain-or-host>/api/v1 (trailing slashes are automatically trimmed)
# Example local: http://localhost:8000/api/v1
# Example production placeholder:
NEXT_PUBLIC_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 3. Event Registration Verification API (Server-Side Only)
# ------------------------------------------------------------------------------
# Server-side endpoint used by registration validation actions to verify external
# registration forms without exposing API keys to the browser.
REGISTRATION_DATA_API=""

# ------------------------------------------------------------------------------
# 4. Search Engine Verification
# ------------------------------------------------------------------------------
# Google Search Console HTML verification code (injected into root <meta> tags).
GOOGLE_SITE_VERIFICATION=""

# ------------------------------------------------------------------------------
# 5. Web Analytics & Real-Time Monitoring
# ------------------------------------------------------------------------------
    # Google Analytics 4 Measurement ID
    NEXT_PUBLIC_GA_MEASUREMENT_ID="G-1PYDC70JVG"

    # Microsoft Clarity Project ID
    NEXT_PUBLIC_CLARITY_ID="uo32coobyn"
